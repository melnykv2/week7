# Copy to .env and adjust if needed: cp .env.example .env
# All values are optional; docker-compose.yaml has sensible defaults.

# Postgres
POSTGRES_DB=hc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Django / Healthchecks
DEBUG=True
SECRET_KEY=local-dev-secret-key-not-for-production
SITE_ROOT=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=8000

# Mailpit web UI
MAILPIT_UI_PORT=8025
